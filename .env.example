# Base URL of the NestJS API, including the /api/v1 global prefix.
# NOTE: this file MUST be saved as UTF-8 (not UTF-16) or Next.js will fail to
# parse it and NEXT_PUBLIC_API_URL will resolve to undefined.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Google Maps Platform API key for the address picker on the checkout page.
# Get this from https://console.cloud.google.com/apis/credentials
# Required APIs: Places API, Geocoding API, Maps JavaScript API
# Billing must be enabled on the Google Cloud Project:
# https://console.cloud.google.com/project/_/billing/enable
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Set to "true" to completely disable Google Maps (address picker and map).
# Use this if you cannot enable billing on your Google Cloud Project.
# Customers can still enter their delivery address manually in the checkout form.
NEXT_PUBLIC_GOOGLE_MAPS_DISABLED=false
